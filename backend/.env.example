# Настройки сервера. Скопируйте файл:  cp .env.example .env  — и заполните.
# Файл .env не попадает в git (он в .gitignore): там пароли и ключи.

# Подключение к PostgreSQL
DATABASE_URL=postgres://postgres:ПАРОЛЬ@localhost:5432/restaurant_management

# Секрет для подписи JWT — минимум 32 случайных символа.
# Сгенерировать:  openssl rand -base64 48
JWT_SECRET=

# Порт веб-сервера (по умолчанию 8080)
PORT=8080

# Ключ Claude API для ИИ-ассистента (console.anthropic.com → API Keys).
# Без него ассистент отвечает «не подключён», остальное работает.
ANTHROPIC_API_KEY=
