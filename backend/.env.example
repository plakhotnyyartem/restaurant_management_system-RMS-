# Настройки сервера. Скопируйте файл:  cp .env.example .env  — и заполните.
# Файл .env не попадает в git (он в .gitignore): там пароли и ключи.

# Подключение к PostgreSQL
DATABASE_URL=postgres://postgres:ПАРОЛЬ@localhost:5432/restaurant_management

# Секрет для подписи JWT — минимум 32 случайных символа.
# Сгенерировать:  openssl rand -base64 48
JWT_SECRET=

# Порт веб-сервера (по умолчанию 8080)
PORT=8080

# ИИ-ассистент: нужен один из двух ключей. Без них он отвечает «не подключён», остальное работает.
# Бесплатно — ключ Google Gemini (aistudio.google.com → Get API key):
AI_API_KEY=
# Другой OpenAI-совместимый сервис (Groq, OpenRouter …) — адрес и модели через запятую; пусто = Gemini:
AI_BASE_URL=
AI_MODEL=
# Платно — ключ Claude API (console.anthropic.com → API Keys); если задан, используется он:
ANTHROPIC_API_KEY=

# Telegram-бот (необязательно): токен от @BotFather → /newbot.
# Без токена бот просто выключен, остальное работает.
TELEGRAM_BOT_TOKEN=
# Во сколько (по местному времени) владельцу приходит утренняя сводка
DIGEST_HOUR=9

# Режим сервера: debug (подробный лог для разработки) или release (для публичного доступа)
GIN_MODE=debug
